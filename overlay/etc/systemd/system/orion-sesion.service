[Unit]
Description=Neo Orión · interfaz a pantalla completa (instalador en el pendrive, HUD ya instalado)
After=systemd-user-sessions.service plymouth-quit-wait.service casper.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
# en el pendrive la cuenta es «orion» (la crea casper); al instalar se cambia por la del dueño
User=orion
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
ExecStart=/usr/local/bin/orion-sesion
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
