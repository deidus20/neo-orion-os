#!/usr/bin/python3
"""Neo Orión · pantalla a pantalla completa para el HUD y el instalador.

Un navegador WebKit sin barras ni menús (GTK 3 + WebKit2GTK 4.1, paquetes oficiales de Ubuntu).
Corre dentro de cage (compositor Wayland de una sola ventana). Solo abre 127.0.0.1: cualquier
enlace externo se manda al navegador normal (Chrome/Firefox) en vez de cargarse aquí.
El micrófono y la cámara se permiten solo a la interfaz local (registro de voz, chat de voz).
"""
import os
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("WebKit2", "4.1")
from gi.repository import Gtk, WebKit2  # noqa: E402

URL = sys.argv[1] if len(sys.argv) > 1 else "http://127.0.0.1:7700/"
LOCAL = ("http://127.0.0.1:", "http://localhost:")


def permiso(_vista, peticion):
    if isinstance(peticion, (WebKit2.UserMediaPermissionRequest, WebKit2.NotificationPermissionRequest)):
        peticion.allow()
    else:
        peticion.deny()
    return True


def decidir(_vista, decision, tipo):
    if tipo in (WebKit2.PolicyDecisionType.NAVIGATION_ACTION, WebKit2.PolicyDecisionType.NEW_WINDOW_ACTION):
        uri = decision.get_navigation_action().get_request().get_uri()
        if not uri.startswith(LOCAL) and not uri.startswith("about:"):
            decision.ignore()
            for b in ("google-chrome-stable", "firefox", "xdg-open"):
                try:
                    subprocess.Popen([b, uri], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    break
                except OSError:
                    continue
            return True
    return False


def main():
    soft = bool(os.environ.get("LIBGL_ALWAYS_SOFTWARE"))
    ajustes = WebKit2.Settings(enable_developer_extras=bool(os.environ.get("ORION_DEPURAR")),
                               enable_media_stream=True, enable_mediasource=True, enable_webaudio=True,
                               enable_webgl=True, enable_smooth_scrolling=False,
                               media_playback_requires_user_gesture=False, enable_write_console_messages_to_stdout=True,
                               hardware_acceleration_policy=WebKit2.HardwareAccelerationPolicy.NEVER if soft
                               else WebKit2.HardwareAccelerationPolicy.ON_DEMAND)
    vista = WebKit2.WebView(settings=ajustes)
    vista.connect("permission-request", permiso)
    vista.connect("decide-policy", decidir)
    vista.connect("web-process-terminated", lambda v, _r: v.reload())   # si el motor se cae, vuelve solo
    v = Gtk.Window(title="Neo Orión")
    v.set_default_size(1280, 800)
    v.set_decorated(False)                    # sin barra de título: la interfaz es toda la pantalla
    v.add(vista)
    v.connect("destroy", Gtk.main_quit)
    v.fullscreen()
    v.show_all()
    vista.load_uri(URL)
    Gtk.main()


if __name__ == "__main__":
    main()
