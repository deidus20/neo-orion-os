#!/usr/bin/env bash
# Neo Orión · comando de consola (todo lo hace el núcleo en Rust, orion-nucleo).
#   orion hud | orion nucleo <orden> | orion fit | orion servidor | orion mcp | orion instalar <config.json> | orion version
N=/usr/local/bin/orion-nucleo
case "${1:-}" in
  hud)   # la interfaz en una ventana, dentro del escritorio que ya tienes
    curl -fs -o /dev/null http://127.0.0.1:7700/ 2>/dev/null || { "$N" servir --modo hud --puerto 7700 >/dev/null 2>&1 & sleep 1; }
    URL=http://127.0.0.1:7700/hud/
    if [ -x /usr/local/bin/orion-pantalla ] && [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then exec /usr/local/bin/orion-pantalla "$URL"; fi
    exec xdg-open "$URL" ;;
  fit) shift; exec "$N" fit "$@" ;;
  servidor) shift; exec "$N" servir "$@" ;;
  nucleo) shift; exec "$N" "$@" ;;
  mcp) shift; exec "$N" mcp "$@" ;;
  instalar) shift; exec sudo "$N" instalar "$@" ;;
  rendimiento) exec "$N" vigia ;;
  version|--version) cat /etc/orion/version 2>/dev/null || echo "Neo Orión"; "$N" --version ;;
  *) echo "uso: orion hud | fit | servidor | nucleo <orden> | mcp | instalar <config.json> | rendimiento | version" ;;
esac
